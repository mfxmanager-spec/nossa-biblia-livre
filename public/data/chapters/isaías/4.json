          "raw_html": "<p class=\"wp-block-paragraph\">De dia.</p>"
        },
        {
          "line_index": 5,
          "text": "E fumaça.",
          "raw_html": "<p class=\"wp-block-paragraph\">E fumaça.</p>"
        },
        {
          "line_index": 6,
          "text": "E labareda de flama de laminado.",
