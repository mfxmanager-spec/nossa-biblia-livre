          "text": "Noite.",
          "raw_html": "<p class=\"wp-block-paragraph\">Noite.</p>"
        },
        {
          "line_index": 8,
          "text": "Que sobre total de peso.",
          "raw_html": "<p class=\"wp-block-paragraph\">Que sobre total de peso.</p>"
        },
        {
          "line_index": 9,
          "text": "Baldaquino.",
          "raw_html": "<p class=\"wp-block-paragraph\">Baldaquino.</p>"
        }
      ]
    },
    {
