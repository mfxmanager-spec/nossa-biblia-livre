          "text": "Dito está.",
          "raw_html": "<p class=\"wp-block-paragraph\">Dito está.</p>"
        },
        {
          "line_index": 6,
          "text": "Para ele.",
          "raw_html": "<p class=\"wp-block-paragraph\">Para ele.</p>"
        },
        {
          "line_index": 7,
          "text": "O total do sido escrito.",
          "raw_html": "<p class=\"wp-block-paragraph\">O total do sido escrito.</p>"
