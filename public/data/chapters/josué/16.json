        },
        {
          "line_index": 5,
          "text": "E está ele.",
          "raw_html": "<p class=\"wp-block-paragraph\">E está ele<sup id=\"rf34-18645\"><a href=\"#fn34-18645\" rel=\"footnote\" title='“&lt;a href=\"https://nossabiblialivre.com/referencias/#AAAAA\" data-type=\"link\" data-id=\"https://nossabiblialivre.com/referencias/#AAAAA\" target=\"_blank\" rel=\"noreferrer noopener\"&gt;E está&lt;/a&gt;” (&lt;em&gt;wayehi&lt;/em&gt;).'>34</a></sup><sup id=\"rf35-18645\"><a href=\"#fn35-18645\" rel=\"footnote\" title='“&lt;a href=\"https://nossabiblialivre.com/referencias/#AAAAB\" data-type=\"link\" data-id=\"https://nossabiblialivre.com/referencias/#AAAAB\" target=\"_blank\" rel=\"noopener\"&gt;Está&lt;/a&gt;” (&lt;em&gt;hyh&lt;/em&gt;).'>35</a></sup>.</p>"
        },
        {
          "line_index": 6,
          "text": "Para mão-de-obra de servidor.",
          "raw_html": "<p class=\"wp-block-paragraph\">Para mão-de-obra de servidor<sup id=\"rf36-18645\"><a href=\"#fn36-18645\" rel=\"footnote\" title=\"“Servidor” (&lt;em&gt;‘bd&lt;/em&gt;). Forma participial da raiz. Cf. Gênesis 2,5; Josué 16,10; 22,5.27; 23,7.16; 24,2.14.15.16.18.19.20.21.22.24.31; Juízes 2,7.11.13.19; 3,6.7.8.14; 9,28.38; 10,6.10.13.16; 1 Samuel 4,9; 7,3.4; 8,8; 11,1. 12,10.14.20.24; 17,9; 26,19.\">36</a></sup>.</p>"
